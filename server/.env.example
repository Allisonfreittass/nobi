# Sem MONGODB_URI, a API sobe um MongoDB embutido (só desenvolvimento) com dados em server/.data
MONGODB_URI=
# Obrigatório em produção
JWT_SECRET=
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Login com Google (opcional): o mesmo Client ID vai em web/.env como VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
# E-mail de "Esqueci a senha" (https://resend.com): chave da API e remetente de um domínio verificado lá
RESEND_API_KEY=
EMAIL_FROM=Nobi <nao-responda@nobievolua.com.br>
# Login com Apple (web): Services ID do Apple Developer (o domínio e a URL de retorno .../entrar precisam estar cadastrados nele)
APPLE_CLIENT_ID=
